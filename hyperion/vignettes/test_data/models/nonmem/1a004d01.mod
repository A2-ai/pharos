$PROBLEM From bbr: see 1a004d01.yaml for details


$INPUT C NUM STUDY COHORT ID TIME ATFD ATLD NTFD NTLD DAY OCC EVID CMT AMT DOSEN
      DOSELOC RATE DV LNDV MDV LLOQ BLQ BWT BAGE BALB SEXF RACEN ECOG BCREAT BEGFR BCRCLR ADMS

$DATA ../../data/derived/1a002d01.csv
IGNORE = @

$SUBROUTINE ADVAN6 TRANS 1 TOL=6 ; ADVAN13 TOL=9;

$MODEL
COMP = (DEPOT)   ; ,DEFDOS
COMP = (CENTRAL) ; ,DEFOBS

$PK

KA=THETA(1)
CL=THETA(2)      *EXP(ETA(1))
V2=THETA(3)      *EXP(ETA(2))

PROP = THETA(4)
ADD  = THETA(5)

F1 = 1      ; Bioavailability

S2 = V2     ;


$DES
CP = A(2)/V2

DADT(1) = -KA*A(1)
DADT(2) = KA*A(1) - (CL/V2)*A(2)



$ERROR (OBSERVATION ONLY)
IPRED = F
W = SQRT((PROP*IPRED)**2+ADD**2)
IRES = DV-IPRED
IWRES = IRES/W
Y = IPRED+W*EPS(1)

$THETA
(0, 0.5)      ; THETA1 KA {1/Time}
(0,0.6)       ; THETA2 CL {Volume/Time} [CL]
(0,3)         ; THETA3 VC or V2 {Volume} [VC]
(0,0.005)     ;Proportional Error
(0,0.2)       ;Additive Error {Concentration}


$OMEGA
0.1       ;1 IIV on CL/F
0.1       ;2 IIV on VC/F

$SIGMA
1 FIX ;

$EST MAXEVAL=9999 METHOD=1 INTER SIGL=6 NSIG=3 PRINT=5 MSFO=ModelSpecificFile.msf
$COV PRINT=E MATRIX = R

$TABLE NUM ID TIME EVID MDV BLQ NPDE IPRED CWRES IWRES
NOPRINT ONEHEADERALL FILE=1a004d01.tab

$TABLE NUM ID  KA CL VC=V2 PROP ADD  ETAS(1:LAST)
NOPRINT NOAPPEND ONEHEADER FILE=1a004d01par.tab
