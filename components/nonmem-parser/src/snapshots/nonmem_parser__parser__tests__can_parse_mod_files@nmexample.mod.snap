    Newline "\n"
    Comment ";Prior information is important for MCMC Bayesian analysis,"
    Newline "\n"
    Comment ";not necessary for maximization methods"
    Newline "\n"
    Comment ";Note the syntax used for defining priors that is available"
    Newline "\n"
    Comment ";as of NONMEM 7.3"
    Newline "\n"
  UnknownRecord
    ControlRecord "$PRIOR"
    Whitespace " "
    Symbol "NWPRI"
  Newline "\n"
  Newline "\n"
  Comment "; Prior information of THETAS"
  Newline "\n"
  UnknownRecord
    ControlRecord "$THETAP"
    Whitespace " "
    LeftParen "("
    Float "2.0"
    Whitespace " "
    Symbol "FIX"
    RightParen ")"
    Symbol "X4"
  Newline "\n"
  Newline "\n"
  Comment "; Variance to prior information of THETAS."
  Newline "\n"
  Comment "; Because variances are very large, this means that the prior"
  Newline "\n"
  Comment "; information to the THETAS is highly uninformative."
  Newline "\n"
