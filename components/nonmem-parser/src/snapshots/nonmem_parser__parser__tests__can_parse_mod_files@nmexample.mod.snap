    Comma ","
    Float "0.0"
    RightParen ")"
  Newline "\n"
  Newline "\n"
  Comment "; Prior information to the OMEGAS."
  Newline "\n"
  UnknownRecord
    ControlRecord "$OMEGAP"
    Whitespace " "
    Symbol "BLOCK"
    LeftParen "("
    Int "4"
    RightParen ")"
    Whitespace " "
    Symbol "FIX"
    Whitespace " "
