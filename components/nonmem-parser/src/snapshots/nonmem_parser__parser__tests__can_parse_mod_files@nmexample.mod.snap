    Whitespace " "
    KeyValue
      Symbol "PRINT"
      Equals "="
      Int "100"
    Whitespace " "
    KeyValue
      Symbol "NOPRIOR"
      Equals "="
      Int "0"
  Newline "\n"
  Newline "\n"
  Comment "; Just for old-times sake, let's see what the traditional"
  Newline "\n"
  Comment "; FOCE method will give us."
  Newline "\n"
  Comment "; And, remember to introduce a new FILE, so its results won't"
  Newline "\n"
  Comment "; append to our Bayesian FILE."
  Newline "\n"
  Comment "; Appending to example1.ext with the EM methods is fine."
  Newline "\n"
  Newline "\n"
  Estimation
    ControlRecord "$EST"
    Whitespace " "
    KeyValue
      Symbol "METHOD"
      Equals "="
      Symbol "COND"
    Whitespace " "
    Flag
      Symbol "INTERACTION"
      Whitespace " "
    KeyValue
      Symbol "MAXEVAL"
      Equals "="
      Int "9999"
    Whitespace " "
    KeyValue
      Symbol "NSIG"
      Equals "="
      Int "3"
    Whitespace " "
    KeyValue
      Symbol "SIGL"
      Equals "="
      Int "10"
    Newline "\n"
    KeyValue
      Symbol "PRINT"
      Equals "="
      Int "5"
    Whitespace " "
    Flag
      Symbol "NOABORT"
      Whitespace " "
    KeyValue
      Symbol "NOPRIOR"
      Equals "="
      Int "1"
    Newline "\n"
    KeyValue
      Symbol "FILE"
      Equals "="
      Symbol "example1.ext"
  Newline "\n"
  Newline "\n"
  Comment "; Time for the standard error results."
  Newline "\n"
  Comment "; You may request a more precise gradient precision (SIGL)"
  Newline "\n"
  Comment "; that differed from that used during estimation."
  Newline "\n"
  Newline "\n"
