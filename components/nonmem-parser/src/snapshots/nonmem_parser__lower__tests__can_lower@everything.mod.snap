expression: model.debug_ast()
input_file: components/nonmem-parser/test_data/everything.mod
---
problem: 'Some header #2'
input:
  Included(ID)
  Included(TIME)
  Included(DV)
  Aliased(DOSE -> AMT)
  Included(DV)
  Included(WT)
  Included(AGE)
  Included(SEX)
  Included(CREA)
  Dropped(DATE)
data:
  "..\\path with spaces\\data.csv"
  ignore:
    Marker("#")
    ValueFilter("DVID" EQ Number(3.0))
    ValueFilter("ID" EQ Number(3.14))
    ValueFilter("DVID" EQ Number(3.0))
    ValueFilter("AGE" GE Number(18.0))
    ValueFilter("AGE" GT Number(3.0))
    ValueFilter("AGE" LT Number(100.0))
    ValueFilter("AGE" LE Number(65.0))
    ValueFilter("TYPE" NE Number(0.0))
    ValueFilter("TYPE" EQ Number(1.0))
    ValueFilter("TYPE" EQN Number(1.0))
    ValueFilter("TYPE" NEN Number(2.0))
    ValueFilter("TYPE" EQ Number(1.0))
  null value: "."
  num records: 200
  other options:
    LAST20=00
