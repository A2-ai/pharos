simulation: (1) (2 NONPARAMETRIC) SUBPROBLEMS=1
msfi: MSFB.MSF
subroutines:
  Builtin(ADVAN4, tol=9)
  Builtin(TRANS4)
  Other(fa.90)
abbreviated:
  REPLACE ETA(1)=ETA(3)
  REPLACE THETA(1)=THETA(5)
  COMRES=5
  DERIV2=NO
pk:
  TVCL = THETA(1)*(WT/70)**THETA(6)
  CL = TVCL*EXP(ETA(1))
  IF (CMT .EQ. 4 .AND. EVID .EQ. 0) THEN { CL = CL*2 }
