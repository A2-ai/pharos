$PROBLEM projH 1001 SCM base -- ADVAN5 TRANS1 transit-abs 2-cmt, covariate candidates released created from pharos see projH-1001_vccat4_metadata.json for details.

$INPUT ID TIME AMT CMT EVID MDV DV LLOQ CV14 DOSEA CV1 CV2 CV3 CV4
CV5 CV6 CV7 CV8 CV9 CV10 CV11 CV12 CV13

$DATA /data/user-homes/brendan/projects/scm-demo/data/PK/1001_Sim.csv
	IGNORE=@

$SUBROUTINE ADVAN5 TRANS1

$MODEL
 COMP = (DOSE)
 COMP = (CENTRAL,DEFOBS)
 COMP = (METABOLITE)
 COMP = (TISSUE)
 COMP = (TRANSABS1)
 COMP = (TRANSABS2)

$PK
TVCL = THETA(1)
CL   = TVCL * EXP(ETA(1))
TVVC = THETA(2)
V2   = TVVC * EXP(ETA(2))
TVVP = THETA(3)
V4   = TVVP * EXP(ETA(3))
TVQ  = THETA(4)
Q    = TVQ * EXP(ETA(4))
TVKA = THETA(5)
KA   = TVKA * EXP(ETA(5))
EMAX = THETA(6)
KM   = THETA(7)
HC   = THETA(16)

F1DOS = (EMAX*((DOSEA-4.5)**HC)/((KM**HC)+((DOSEA-4.5)**HC)))

CAT1 = 0
IF(CV8.EQ.2) CAT1=1

CAT2=0
IF(CV10.GE.1.AND.CV14.EQ.102) CAT2=1

CAT3=0
IF(CV12.EQ.2) CAT3=1

CAT4=0
IF(CV12.EQ.1.OR.CV13.EQ.1) CAT4=1

CONT1=70
IF(CV1.GT.0) CONT1=CV1

VCCV1     = (CONT1/70)**THETA(13)
CLCV1     = (CONT1/70)**THETA(14)

KACAT1    = (1+CAT1*THETA(8))
KACAT2  = (1+CAT2*THETA(9))

CLCAT3  = (1+CAT3*THETA(10))
VCCAT3  = (1+CAT3*THETA(15))

CLCAT4 = (1+CAT4*THETA(11))
VCCAT4 = (1+CAT4*THETA(12))

KA=KA*KACAT1*KACAT2
CL=CL*CLCAT3*CLCV1*CLCAT4
V2=V2*VCCV1*VCCAT3*VCCAT4
V4=V4
K15=KA
K56=KA
K62=KA
K24=Q/V2
K42=Q/V4
K20=CL/V2

F1=1*(1+F1DOS)

S2= V2/1000

$ERROR (OBSERVATION ONLY)
IPRED=F
IF(CV11.EQ.0) W = SQRT((IPRED**2)*SIGMA(1,1)+SIGMA(3,3))
IF(CV11.GE.1) W = SQRT((IPRED**2)*SIGMA(2,2)+SIGMA(4,4))

IRES=DV-IPRED
IWRES=IRES/W
IF(CV11.EQ.0) Y=IPRED+IPRED*EPS(1)+EPS(3)
IF(CV11.GE.1) Y=IPRED+IPRED*EPS(2)+EPS(4)


$THETA
